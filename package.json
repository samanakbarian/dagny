{
  "name": "dagny",
  "private": true,
  "version": "1.0.0",
  "description": "Dagnys äventyr – ett mysigt 2D-actionäventyr i 1960-talets Sverige",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node --experimental-strip-types --no-warnings scripts/gen-icons.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
